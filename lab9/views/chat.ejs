<%- include('partials/header') %>

<div class="page-header">
    <h1>Чат поддержки авиакомпании «Взлёт»</h1>
</div>

<div class="chat-wrapper">
    <!-- Форма входа -->
    <div id="login-form" class="form-container" style="margin-bottom: 20px;">
        <h3>Вход в чат</h3>
        <div class="form-group">
            <label>Ваше имя:</label>
            <input type="text" id="username" class="form-control" placeholder="Введите ваше имя">
        </div>
        <div class="form-group">
            <label>Роль:</label>
            <select id="role" class="form-control">
                <option value="User">Пассажир (User)</option>
                <option value="Admin">Администратор (Admin)</option>
            </select>
        </div>
        <button onclick="joinChat()" class="btn btn-primary">Войти в чат</button>
    </div>

    <!-- Окно чата (скрыто до входа) -->
    <div id="chat-window" style="display:none;">
        <div id="chat-header" style="background: #003580; color: white; padding: 10px; border-radius: 8px 8px 0 0;">
            <span id="current-user"></span>
            <button onclick="leaveChat()" style="float: right; background: #dc3545; color: white; border: none; padding: 5px 10px; border-radius: 4px; cursor: pointer;">Выйти</button>
        </div>
        <div id="messages" style="height: 400px; overflow-y: auto; padding: 15px; background: #f9f9f9; border: 1px solid #ddd;"></div>
        <div class="chat-input-area">
            <input type="text" id="messageInput" placeholder="Введите сообщение..." onkeypress="if(event.key==='Enter') sendMessage()">
            <button onclick="sendMessage()" class="btn btn-primary">Отправить</button>
        </div>
    </div>
</div>

<script src="/socket.io/socket.io.js"></script>
<script>
    let socket = null;
    let currentUser = null;
    let currentRole = null;

    function joinChat() {
        const username = document.getElementById('username').value.trim();
        const role = document.getElementById('role').value;
        
        if (!username) {
            alert('Пожалуйста, введите ваше имя');
            return;
        }
        
        currentUser = username;
        currentRole = role;
        
        // Подключаемся к Socket.IO
        socket = io();
        
        // Отправляем событие входа
        socket.emit('join', { username: currentUser, role: currentRole });
        
        // Показываем окно чата
        document.getElementById('login-form').style.display = 'none';
        document.getElementById('chat-window').style.display = 'block';
        document.getElementById('current-user').innerHTML = `Вы вошли как: <strong>${currentUser}</strong> (${currentRole === 'Admin' ? 'Администратор' : 'Пассажир'})`;
        document.getElementById('messageInput').focus();
        
        // Обработчики Socket.IO событий
        socket.on('message', (data) => {
            addMessage(data);
        });
        
        socket.on('messageDeleted', (messageId) => {
            const msgElement = document.getElementById(`msg-${messageId}`);
            if (msgElement) {
                msgElement.remove();
            }
        });
        
        socket.on('userBlocked', (data) => {
            if (currentUser === data.username) {
                alert('Вы были заблокированы администратором!');
                leaveChat();
            } else {
                addMessage({ user: 'System', text: `${data.username} был заблокирован`, role: 'system' });
            }
        });
    }
    
    function addMessage(data) {
        const messagesDiv = document.getElementById('messages');
        const messageDiv = document.createElement('div');
        messageDiv.id = data.id ? `msg-${data.id}` : `msg-${Date.now()}`;
        messageDiv.className = `message ${data.role === 'Admin' ? 'admin-message' : (data.role === 'system' ? 'system-message' : 'user-message')}`;
        
        let deleteButton = '';
        if (currentRole === 'Admin' && data.user !== 'System' && data.id) {
            deleteButton = `<button onclick="deleteMessage(${data.id})" class="btn-delete-msg" title="Удалить сообщение">✕</button>`;
        }
        
        const time = new Date().toLocaleTimeString();
        
        messageDiv.innerHTML = `
            <div class="message-header">
                <span><strong>${escapeHtml(data.user)}</strong> 
                    ${data.role && data.role !== 'system' ? `<span class="message-role ${data.role === 'Admin' ? 'admin' : 'user'}">${data.role === 'Admin' ? 'Админ' : 'Пассажир'}</span>` : ''}
                </span>
                ${deleteButton}
            </div>
            <div class="message-text">${escapeHtml(data.text)}</div>
            <div class="message-time">${time}</div>
        `;
        
        messagesDiv.appendChild(messageDiv);
        messagesDiv.scrollTop = messagesDiv.scrollHeight;
    }
    
    function sendMessage() {
        const input = document.getElementById('messageInput');
        const text = input.value.trim();
        
        if (text && socket) {
            socket.emit('sendMessage', text);
            input.value = '';
        }
    }
    
    function deleteMessage(messageId) {
        if (socket && currentRole === 'Admin') {
            socket.emit('deleteMessage', messageId);
        }
    }
    
    function leaveChat() {
        if (socket) {
            socket.disconnect();
        }
        document.getElementById('login-form').style.display = 'block';
        document.getElementById('chat-window').style.display = 'none';
        document.getElementById('username').value = '';
        document.getElementById('messages').innerHTML = '';
    }
    
    function escapeHtml(str) {
        if (!str) return '';
        return str.replace(/[&<>]/g, function(m) {
            if (m === '&') return '&amp;';
            if (m === '<') return '&lt;';
            if (m === '>') return '&gt;';
            return m;
        });
    }
</script>

<style>
    .message {
        margin-bottom: 12px;
        padding: 10px 12px;
        border-radius: 8px;
        background: white;
        box-shadow: 0 1px 2px rgba(0,0,0,0.1);
    }
    .user-message {
        border-left: 4px solid #28a745;
    }
    .admin-message {
        border-left: 4px solid #dc3545;
        background: #fff5f5;
    }
    .system-message {
        background: #e8f0fe;
        text-align: center;
        font-style: italic;
        font-size: 13px;
        color: #666;
    }
    .message-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 5px;
    }
    .message-role {
        font-size: 10px;
        padding: 2px 6px;
        border-radius: 10px;
        margin-left: 8px;
    }
    .message-role.admin {
        background: #dc3545;
        color: white;
    }
    .message-role.user {
        background: #28a745;
        color: white;
    }
    .message-text {
        margin: 5px 0;
        word-wrap: break-word;
    }
    .message-time {
        font-size: 10px;
        color: #999;
        margin-top: 5px;
    }
    .btn-delete-msg {
        background: none;
        border: none;
        color: #dc3545;
        cursor: pointer;
        font-size: 14px;
        font-weight: bold;
        padding: 0 5px;
    }
    .btn-delete-msg:hover {
        color: #c82333;
    }
</style>

<%- include('partials/footer') %>